  "components": {
    "schemas": {
      "DecisionBatch": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Scenario Id"
          },
          "customer_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Customer Id"
          },
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/DecisionContract"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Proposals"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "customer_id",
          "proposals"
        ],
        "title": "DecisionBatch",
        "description": "External adapter envelope for one coordinated multi-agent decision."
      },
      "DecisionContract": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Proposal Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Agent Id"
          },
          "customer_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Customer Id"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "issue_credit",
              "send_marketing",
              "schedule_callback",
              "resolve_case"
            ],
            "title": "Action Type"
          },
          "amount_mad": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Amount Mad",
            "default": 0
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "sms",
              "phone",
              "internal",
              "none"
            ],
            "title": "Channel",
            "default": "none"
          },
          "priority": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Priority",
            "default": 3
          },
          "utility": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Utility",
            "default": 50
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          },
          "reversible": {
            "type": "boolean",
            "title": "Reversible",
            "default": true
          },
          "requires_human": {
            "type": "boolean",
            "title": "Requires Human",
            "default": false
          },
          "proposed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Proposed At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "expected_state_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected State Version"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Evidence"
          },
          "rationale": {
            "type": "string",
            "maxLength": 500,
            "title": "Rationale",
            "default": ""
          },
          "context_note": {
            "type": "string",
            "maxLength": 500,
            "title": "Context Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposal_id",
          "idempotency_key",
          "agent_id",
          "customer_id",
          "action_type",
          "proposed_at"
        ],
        "title": "DecisionContract",
        "description": "Typed, bounded contract submitted by an autonomous business agent."
      },
      "GroqCredentialInput": {
        "properties": {
          "api_key": {
            "type": "string",
            "title": "Api Key"
          }
        },
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "GroqCredentialInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveRunRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "enum": [
              "customer-journey",
              "consent-boundary"
            ],
            "title": "Scenario Id"
          },
          "negotiation": {
            "type": "string",
            "enum": [
              "standard",
              "deep"
            ],
            "title": "Negotiation",
            "default": "deep"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id"
        ],
        "title": "LiveRunRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "TreatyAIIntegrationBearer": {
        "type": "http",
        "description": "Separate service bearer credential for the external Salesforce adapter.",
        "scheme": "bearer"
      }
    }
  }
}
